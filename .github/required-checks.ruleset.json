{
  "name": "Documentation CI",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          { "context": "fern-check", "integration_id": 15368 },
          { "context": "Docs Preview", "integration_id": 15368 }
        ]
      }
    }
  ]
}
